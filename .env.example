PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
JWT_SECRET=replace-with-long-random-secret
UPLOAD_MAX_FILE_SIZE_MB=10

# Optional Cloudflare R2 uploads
# When all R2_* values below are set, image uploads are stored in R2.
# R2_PUBLIC_URL should be your public bucket URL or custom domain, without a trailing slash.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
R2_UPLOAD_PREFIX=uploads

# Razorpay (required for payment endpoints)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Public app URLs used for QR links and PDFs
FRONTEND_URL=https://your-frontend-domain.vercel.app
PUBLIC_APP_URL=https://your-frontend-domain.vercel.app
QR_BASE_URL=https://your-frontend-domain.vercel.app

# Optional auth behavior (only for dev/testing)
USE_DEFAULT_TEST_OTP=false
DEFAULT_TEST_OTP=123456
# WhatsApp Cloud API OTP delivery (required outside development)
# Use an approved Meta WhatsApp template that accepts the OTP code.
WHATSAPP_GRAPH_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_OTP_TEMPLATE_NAME=your_otp_template_name
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en

# Claim QR testing
CLAIM_TOKEN_TTL_MINUTES=10

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Cashback App" <your-email@gmail.com>

# RBL UPI Payment Gateway
RBL_BASE_URL=https://apideveloper.rbl.bank.in/test/sb/rbl/api/v1/upi
RBL_CLIENT_ID=your_rbl_client_id
RBL_CLIENT_SECRET=your_rbl_client_secret
RBL_LDAP_USER=your_ldap_user
RBL_LDAP_PASS=your_ldap_password
# Channel-partner login sent in the XML body of channelpartnerloginreq (not the basic-auth user)
RBL_LOGIN_USERNAME=your_channel_partner_username
RBL_LOGIN_PASSWORD=your_channel_partner_password_hash
RBL_MERCHANT_ID=your_mrchOrgId
RBL_AGGREGATOR_ID=your_aggrOrgId
RBL_BC_AGENT=your_bcagent
RBL_HMAC_SECRET=your_hmac_secret
RBL_PAYER_VPA=your_vpa@rbl
RBL_PAYER_NAME="Your Company Name"

# RBL UPI Payout Engine (src/services/rblPayoutService.js)
# Max amount per single UPI payout; leave blank for no limit
RBL_MAX_TXN_AMOUNT=
# Seconds after sending before the first status enquiry
RBL_FIRST_STATUS_CHECK_SEC=20
# Minutes between enquiries while the bank reports IN PROGRESS
RBL_REQUERY_INTERVAL_MIN=20
# Seconds between enquiries while the bank reports NOT FOUND (3 strikes -> resend with same ids)
RBL_NOT_FOUND_RETRY_SEC=60
# Days to keep re-querying before putting a payout on hold (RBL keeps enquiry data 7 days)
RBL_MAX_REQUERY_DAYS=7
# Server-local hour after which the daily reconciliation runs
RBL_RECON_HOUR=2
# Set to false to disable the background requery/reconciliation worker
RBL_PAYOUT_WORKER_ENABLED=true
# HTTP timeout for RBL API calls (ms)
RBL_TIMEOUT_MS=30000
